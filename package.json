{
  "name": "api-for-cursor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "OpenAI-compatible Chat Completions and Responses API for Cursor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexagram-sec/API-For-Cursor.git"
  },
  "homepage": "https://github.com/hexagram-sec/API-For-Cursor#readme",
  "bugs": {
    "url": "https://github.com/hexagram-sec/API-For-Cursor/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sdk:opencode-bridge": "node scripts/cursor-sdk-local-agent-bridge.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply composer-api --local",
    "desktop": "electron .",
    "dist:win": "node scripts/prepare-win-pack.mjs && electron-builder --win"
  },
  "keywords": [
    "cursor",
    "composer",
    "openai",
    "chat-completions",
    "responses-api",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.13",
    "lucide": "^0.557.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@cloudflare/workers-types": "^4.20260520.0",
    "@types/node": "^22.20.1",
    "electron": "^36.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.15",
    "wrangler": "^4.93.0"
  }
}
